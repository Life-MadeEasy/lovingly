window.calUrl=function(a){const d=a.dataset,f=x=>new Date(x).toISOString().replace(/[-:]|\.\d{3}/g,''),fb='https://calendar.google.com/calendar/render?action=TEMPLATE&text='+encodeURIComponent(d.t)+'&dates='+f(d.s)+'/'+f(d.e)+'&location='+encodeURIComponent(d.l);return 'intent:#Intent;action=android.intent.action.INSERT;type=vnd.android.cursor.dir/event;S.title='+encodeURIComponent(d.t)+';S.eventLocation='+encodeURIComponent(d.l)+';l.beginTime='+Date.parse(d.s)+';l.endTime='+Date.parse(d.e)+';S.browser_fallback_url='+encodeURIComponent(fb)+';end'};
document.querySelectorAll('.cal').forEach(a=>a.addEventListener('click',e=>{if(!/Android/i.test(navigator.userAgent))return;e.preventDefault();location.href=calUrl(a)}));
const o=new IntersectionObserver(e=>e.forEach(n=>{if(n.isIntersecting){n.target.classList.add("s");o.unobserve(n.target)}}),{threshold:.1});
document.querySelectorAll(".r").forEach(e=>o.observe(e));
</script></body></html>
